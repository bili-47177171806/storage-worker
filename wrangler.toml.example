# Example Wrangler config — copy to wrangler.toml.local (gitignored) for deploy.
#   cp wrangler.toml.example wrangler.toml.local
#   npx wrangler secret put OSS_AKID -c wrangler.toml.local
#   npx wrangler secret put OSS_AKS  -c wrangler.toml.local
#   npx wrangler deploy -c wrangler.toml.local
#
# Never commit AccessKey Id/Secret or real production hostnames.

name = "storage"
main = "worker.js"
compatibility_date = "2026-02-10"

[vars]
OSS_BUCKET = "your-bucket-name"
OSS_ENDPOINT = "oss-cn-hangzhou.aliyuncs.com"
OSS_PREFIX = "AttachFiles"
OSS_UPLOAD_HOST = ""
# auto | put | post  (when OSS_AKS is set)
OSS_PUT_MODE = "auto"
# SIGN_BACKEND = "https://sign.example.com"  # only if OSS_AKS unset
PUBLIC_STORAGE_HOST = "https://storage.example.com"
PUBLIC_R2_HOST = "https://media.example.com"
